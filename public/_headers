# Hashed assets never change content for a given name -> cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry must always be revalidated so new deploys (with new chunk
# hashes) are picked up immediately instead of loading stale references.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
